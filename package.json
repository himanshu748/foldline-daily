{
  "private": true,
  "name": "contrarian-daily",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "npm run typecheck && npm run lint && npm test && devvit upload",
    "dev": "devvit playtest",
    "harness": "vite --config tools/harness/vite.config.ts",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "size": "node tools/check-bundle.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --build"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "dependencies": {
    "@devvit/analytics": "0.15.3",
    "@devvit/start": "0.15.3",
    "@devvit/web": "0.15.3",
    "@hono/node-server": "2.1.11",
    "devvit": "0.15.3",
    "hono": "4.13.21",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@devvit/test": "0.15.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.13.3",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  },
  "license": "BSD-3-Clause"
}
